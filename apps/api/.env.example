# Copié vers apps/api/.env par « pnpm infra:setup » (valeurs alignées sur infra/.env).
# Toute variable lue par l'API est validée au démarrage (src/config/env.ts).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Origines autorisées (séparées par des virgules) ; obligatoire en production.
CORS_ORIGINS=http://localhost:5000,http://localhost:5001,http://localhost:5002,http://localhost:5173
# Nombre de proxys inverses devant l'API ; obligatoire en production (0 si exposée directement).
TRUST_PROXY=0
# Requêtes par minute et par adresse IP.
RATE_LIMIT_PER_MINUTE=120

# Utilisées par les prochaines étapes de la M1 (base de données, Keycloak, recherche, médias, e-mails).
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=plumiotheca
DB_PASSWORD=<infra>
DB_NAME=plumiotheca
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=plumiotheca
KEYCLOAK_CLIENT_ID=api
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=<infra>
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=medias
S3_ACCESS_KEY_ID=<garage>
S3_SECRET_ACCESS_KEY=<garage>
SMTP_HOST=localhost
SMTP_PORT=1025
