{
  "name": "@plumiotheca/api",
  "version": "0.0.0",
  "private": true,
  "description": "API de Plumiotheca (NestJS).",
  "license": "MIT",
  "author": "ellexart",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @plumiotheca/contracts --filter @plumiotheca/editor-schema build && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "pnpm --filter @plumiotheca/contracts --filter @plumiotheca/editor-schema build && nest start --watch --env-file .env",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "search:reindex": "node --env-file-if-exists=.env dist/cli/reindex.js",
    "migration:run": "node --env-file-if-exists=.env node_modules/typeorm/cli.js -d dist/database/data-source.js migration:run",
    "migration:revert": "node --env-file-if-exists=.env node_modules/typeorm/cli.js -d dist/database/data-source.js migration:revert",
    "migration:generate": "pnpm build && node --env-file-if-exists=.env node_modules/typeorm/cli.js -d dist/database/data-source.js migration:generate --pretty",
    "migration:check": "node --env-file-if-exists=.env node_modules/typeorm/cli.js -d dist/database/data-source.js migration:generate --check src/database/migrations/Verification"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-presigned-post": "^3.1153.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@plumiotheca/contracts": "workspace:*",
    "@plumiotheca/editor-schema": "workspace:*",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.0",
    "pg-boss": "~12.38.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.9",
    "@nestjs/testing": "^12.2.0",
    "@standard-schema/spec": "^1.1.0",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
