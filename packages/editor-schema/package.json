{
  "name": "@plumiotheca/editor-schema",
  "version": "0.0.0",
  "private": true,
  "description": "Schéma des chapitres (JSON ProseMirror/TipTap) partagé entre l'éditeur web et l'API : nœuds autorisés, identifiants de blocs, nombre de mots.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@plumiotheca/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/html": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/node": "^24.13.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
