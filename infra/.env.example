# Copié vers infra/.env par « pnpm infra:setup », qui remplace les valeurs <généré>
# par des secrets aléatoires. Ne jamais committer infra/.env.

POSTGRES_USER=plumiotheca
POSTGRES_DB=plumiotheca
POSTGRES_PASSWORD=<généré>
KEYCLOAK_DB_PASSWORD=<généré>

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=<généré>

MEILI_MASTER_KEY=<généré>

GARAGE_RPC_SECRET=<généré-hex>
GARAGE_ADMIN_TOKEN=<généré>
